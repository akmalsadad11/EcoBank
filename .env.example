PORT=4000
NODE_ENV=development

# Koneksi PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecobank
# Isi true jika database di hosting (Neon, Supabase, Railway, dll) mewajibkan SSL
DATABASE_SSL=false

# Wajib diganti: string acak panjang (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-minimal-32-karakter

# Alamat frontend yang boleh memanggil API (pisahkan dengan koma). Kosongkan = izinkan semua (hanya untuk dev)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# URL publik backend (untuk link foto bukti). Kosongkan saat lokal
PUBLIC_URL=

# Akun admin pertama (dibuat oleh npm run db:seed)
ADMIN_NAMA=Administrator
ADMIN_TELEPON=081200000000
ADMIN_EMAIL=admin@ecobank.local
ADMIN_PASSWORD=Admin12345

# true = buat juga 1 petugas dan 1 nasabah contoh (petugas123 / nasabah123)
SEED_DEMO=true
